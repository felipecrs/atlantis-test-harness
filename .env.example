# Bitbucket Cloud. See bitbucket-cloud/README.md for how to set it up.

# A throwaway repository, on a Premium workspace.
BITBUCKET_CLOUD_REPO=workspace/repository

# The account Atlantis runs as. The API token needs read:user, and read and
# write for repository and pullrequest. No admin, so that we don't hide
# permission problems.
BITBUCKET_CLOUD_EMAIL=
BITBUCKET_CLOUD_TOKEN=

# The same account, but with read and admin for repository, read for
# pullrequest, and read, write and delete for webhook. Only used to manage the
# branch restrictions and webhooks.
BITBUCKET_CLOUD_ADMIN_TOKEN=

# Optional, another account with read access to the repository and the same
# scopes as BITBUCKET_CLOUD_TOKEN. Tests that need it are skipped otherwise.
BITBUCKET_CLOUD_SECOND_EMAIL=
BITBUCKET_CLOUD_SECOND_TOKEN=

# Optional, a branch with a merge queue.
BITBUCKET_CLOUD_MERGE_QUEUE=

# Bitbucket Server. Optional, to try another version.
# BITBUCKET_SERVER_IMAGE=atlassian/bitbucket:9.4
