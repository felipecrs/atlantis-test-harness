# Only for Bitbucket Cloud. See bitbucket.md for how to set it up.

# A throwaway repository, on a Premium workspace.
BB_REPO=workspace/repository

# The account Atlantis runs as. The API token needs read:user, and read and
# write for repository and pullrequest. No admin, so that we don't hide
# permission problems.
BB_EMAIL=
BB_TOKEN=

# The same account, but with read and admin for repository, read for
# pullrequest, and read, write and delete for webhook. Only used to manage the
# branch restrictions and webhooks.
BB_ADMIN_TOKEN=

# Optional, another account with read access to the repository and the same
# scopes as BB_TOKEN. Tests that need it are skipped otherwise.
BB2_EMAIL=
BB2_TOKEN=

# Optional, a branch with a merge queue. See bitbucket.md.
BB_MERGE_QUEUE=
